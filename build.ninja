BLOCKSDS = /opt/wonderful/thirdparty/blocksds/core
BLOCKSDSEXT = /opt/wonderful/thirdparty/blocksds/external
WONDERFUL_TOOLCHAIN = /opt/wonderful

ARM_NONE_EABI_PATH = ${WONDERFUL_TOOLCHAIN}/toolchain/gcc-arm-none-eabi/bin/
LLVM_TEAK_PATH     = ${WONDERFUL_TOOLCHAIN}/toolchain/llvm-teak/bin/

PREFIX   = ${ARM_NONE_EABI_PATH}arm-none-eabi-
CC_ARM   = ${PREFIX}gcc
CXX_ARM  = ${PREFIX}g++

CC_TEAK  = ${LLVM_TEAK_PATH}clang
CXX_TEAK = ${LLVM_TEAK_PATH}clang++
LD_TEAK  = ${LLVM_TEAK_PATH}ld.lld

BIN2C     = ${BLOCKSDS}/tools/bin2c/bin2c
GRIT      = ${BLOCKSDS}/tools/grit/grit
SQUEEZERW = ${BLOCKSDS}/tools/squeezer/squeezerw
MMUTIL    = ${BLOCKSDS}/tools/mmutil/mmutil
NDSTOOL   = ${BLOCKSDS}/tools/ndstool/ndstool
TEAKTOOL  = ${BLOCKSDS}/tools/teaktool/teaktool
DSLTOOL   = ${BLOCKSDS}/tools/dsltool/dsltool

OBJ2DL      = python3 /opt/wonderful/thirdparty/blocksds/external/nitro-engine/tools/obj2dl/obj2dl.py
MD5_TO_DSMA = python3 /opt/wonderful/thirdparty/blocksds/external/nitro-engine/tools/md5_to_dsma/md5_to_dsma.py
PTEXCONV    = ${BLOCKSDSEXT}/ptexconv/ptexconv

rule makedir
  command = mkdir $out

rule copy
  command = cp $in $out

rule bin2c
  command = ${BIN2C} $in $outdir

rule mmutil
  command =  ${MMUTIL} $in -d -o${soundbank_bin} -h${soundbank_info_h}

rule mmutil_mas
  command =  ${MMUTIL} $in -d -m -o${out}

rule as_arm
  command = ${CC_ARM} ${asflags} -MMD -MP -c -o $out $in
  deps = gcc
  depfile = ${dep}

rule cc_arm
  command = ${CC_ARM} ${cflags} -MMD -MP -c -o $out $in
  deps = gcc
  depfile = ${dep}

rule cxx_arm
  command = ${CXX_ARM} ${cxxflags} -MMD -MP -c -o $out $in
  deps = gcc
  depfile = ${dep}

rule ld_arm
  command = ${CC_ARM} -o $out $in ${ldflags}

rule as_teak
  command = ${CC_TEAK} ${asflags} -MMD -MP -c -o $out $in
  deps = gcc
  depfile = ${dep}

rule cc_teak
  command = ${CC_TEAK} ${cflags} -MMD -MP -c -o $out $in
  deps = gcc
  depfile = ${dep}

rule cxx_teak
  command = ${CXX_TEAK} ${cxxflags} -MMD -MP -c -o $out $in
  deps = gcc
  depfile = ${dep}

rule ld_teak
  command = ${LD_TEAK} -o $out $in ${ldflags}

rule teaktool
  command = ${TEAKTOOL} -i $in -o $out

rule dsltool
  command = ${DSLTOOL} -i ${elf_path} -o $out ${args}

rule ndstool
  command = ${NDSTOOL} -c $out -7 ${arm7elf} -9 ${arm9elf} -b ${game_icon} ${game_full_title} ${ndstool_nitrofs_flags} ${ndstool_title_id} ${ndstool_unit_code}

rule grit
  command = ${GRIT} ${in_path_img} ${options} -o ${grit_out_path}

rule squeezerw
  command = ${SQUEEZERW} ${args}

rule grit_nf_shared
  command = ${GRIT} ${in_files_png} ${options}

rule obj2dl
  command = ${OBJ2DL} --input ${in_path_obj} --output $out ${args}

rule md5_to_dsma
  command = ${MD5_TO_DSMA} ${args}

rule ptexconv
  command = ${PTEXCONV} ${args}

